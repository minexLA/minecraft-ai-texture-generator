# Default AI provider: pollinations | mock | huggingface | openai | gemini | replicate | fal | local_sd
DEFAULT_PROVIDER=pollinations

# Allowed CORS origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Free Cloud Option 1: Pollinations.ai (Flux) -> Needs NO API key! Set DEFAULT_PROVIDER=pollinations
# Free Cloud Option 2: Hugging Face Free Token (No credit card required, get at https://huggingface.co/settings/tokens)
HF_TOKEN=
HF_MODEL=black-forest-labs/FLUX.1-schnell

# Optional Cloud & Local Provider Credentials (leave blank to use Built-in Procedural Provider)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-schnell

FAL_KEY=
FAL_MODEL=fal-ai/flux/schnell

LOCAL_SD_URL=http://127.0.0.1:7860

